# Copy to .env.local. For local Supabase, `supabase status` prints both values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Show the "Sign in with Google" options. Turn on once Google is set up in Supabase.
NEXT_PUBLIC_GOOGLE_SIGN_IN=false
# Google OAuth client id (public). Enables Google's own sign-in button, whose popup names
# this site instead of "<project>.supabase.co". Without it, sign-in uses the redirect flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Only for `npm run test:db`, to run the Google-merge test with a throwaway user.
# Never expose this to the browser or commit it.
# SUPABASE_SECRET_KEY=sb_secret_xxx
